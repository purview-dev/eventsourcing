{
	"SampleAppHostKit": {
		"WebApp": {
			"AdminSitePath": "/admin",
			"AdminAPIPath": "/admin/api",
			"DataIsolationWarning": "Each sample option uses isolated backing data. Switching store types changes the seeded dataset that you see.",
			"Variants": {

				"sql-server": {
					"ResourceName": "sample-web-app",
					"DisplayName": "SQL Server",
					"Description": "SQL Server event store with SQL Server query snapshots and admin API.",
					"EventStore": "SqlServer",
					"QueryStore": "SqlServer",
					"AdminStore": "SqlServer",
					"AdminAPIAvailable": true,
					"EventStoreConnectionName": "eventstore-db",
					"QueryStoreConnectionName": "eventstore-db"
				},
				"postgres": {
					"ResourceName": "sample-web-postgres",
					"DisplayName": "Postgres",
					"Description": "Postgres event store with Postgres query snapshots and admin API.",
					"EventStore": "Postgres",
					"QueryStore": "Postgres",
					"AdminStore": "Postgres",
					"AdminAPIAvailable": true,
					"EventStoreConnectionName": "eventstore-postgres-db",
					"QueryStoreConnectionName": "eventstore-postgres-db"
				},
				"mongo-db": {
					"ResourceName": "sample-web-mongo",
					"DisplayName": "MongoDB",
					"Description": "MongoDB event store with MongoDB query snapshots and admin API.",
					"EventStore": "MongoDb",
					"QueryStore": "MongoDb",
					"AdminStore": "MongoDb",
					"AdminAPIAvailable": true,
					"EventStoreConnectionName": "eventstore-mongo",
					"QueryStoreConnectionName": "eventstore-mongo",
					"EventStoreDatabaseName": "eventstore-mongo-db",
					"QueryStoreDatabaseName": "eventstore-mongo-db",
					"AdminDatabaseName": "eventstore-mongo-db"
				},
				"azure-storage-sql": {
					"ResourceName": "sample-web-azure-sql",
					"DisplayName": "Azure Storage + SQL Server query store",
					"Description": "Azure Storage append-only event store with SQL Server query snapshots in a dedicated shared database.",
					"EventStore": "AzureStorage",
					"QueryStore": "SqlServer",
					"AdminStore": "AzureStorage",
					"AdminAPIAvailable": true,
					"EventStoreConnectionName": "eventstore-tables",
					"QueryStoreConnectionName": "eventstore-shared-db"
				},
				"azure-storage-postgres": {
					"ResourceName": "sample-web-azure-postgres",
					"DisplayName": "Azure Storage + Postgres query store",
					"Description": "Azure Storage append-only event store with Postgres query snapshots in a dedicated shared database.",
					"EventStore": "AzureStorage",
					"QueryStore": "Postgres",
					"AdminStore": "AzureStorage",
					"AdminAPIAvailable": true,
					"EventStoreConnectionName": "eventstore-tables",
					"QueryStoreConnectionName": "eventstore-postgres-shared-db"
				},
				"azure-storage-mongo": {
					"ResourceName": "sample-web-azure-mongo",
					"DisplayName": "Azure Storage + MongoDB query store",
					"Description": "Azure Storage append-only event store with MongoDB query snapshots in a dedicated shared database.",
					"EventStore": "AzureStorage",
					"QueryStore": "MongoDb",
					"AdminStore": "AzureStorage",
					"AdminAPIAvailable": true,
					"EventStoreConnectionName": "eventstore-tables",
					"QueryStoreConnectionName": "eventstore-mongo",
					"QueryStoreDatabaseName": "eventstore-mongo-shared-db"
				}
			}
		}
	}
}