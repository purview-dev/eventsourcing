<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<DisableSourceLink>true</DisableSourceLink>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
		<IsRoslynComponent>true</IsRoslynComponent>
		<!-- snupkg requires standard build output, which this analyzer package suppresses. -->
		<SymbolPackageFormat>symbols.nupkg</SymbolPackageFormat>
		<TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);PackSourceGeneratorSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
		<!-- Exclude Purview.Telemetry.SourceGenerator since this is a netstandard2.0 analyzer project -->
		<ExcludePurviewTelemetry>true</ExcludePurviewTelemetry>
		<AssemblyName>Purview.EventSourcing.SourceGeneration</AssemblyName>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!--<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
		<!--<NoWarn>$(NoWarn);CS8632;RS1035;RS1036;RS2008</NoWarn>-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Purview.SourceGeneratorFramework" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Templates\**\*.cs" />
		<EmbeddedResource Include="Templates\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Purview.EventSourcing.SourceGenerator.Common" />
		<Using
			Include="Purview.EventSourcing.SourceGenerator.Common.TypeLibrary"
			Alias="TypeLibrary"
		/>
		<Using Include="Purview.EventSourcing.SourceGenerator.Aggregate" />
		<Using Include="Purview.EventSourcing.SourceGenerator.Aggregate.Models" />
		<Using Include="Purview.EventSourcing.SourceGenerator.ValueObject" />
		<Using Include="Purview.EventSourcing.SourceGenerator.ValueObject.Models" />
	</ItemGroup>
</Project>
