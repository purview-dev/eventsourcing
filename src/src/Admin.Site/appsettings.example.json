{
  "AdminPortal": {
    "Enabled": true,
    "ApiPathPrefix": "/api/admin",
    "EnableAggregateSearch": true,
    "EnableEventInspection": true,
    "EnableProjection": true,
    "EnableExport": false,
    "Paging": {
      "DefaultPageSize": 25,
      "MaxPageSize": 100
    },
    "Projection": {
      "MaxEventsToReplay": 10000,
      "TimeoutSeconds": 30
    },
    "Features": {
      "DeprecatedEventHandling": "skip"
    }
  }
}
