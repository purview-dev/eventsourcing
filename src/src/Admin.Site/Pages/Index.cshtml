@page
@model Purview.EventSourcing.Admin.Site.Pages.IndexModel

@{
	ViewData["Title"] = "Aggregates";
}

<div class="admin-container">
	<h1>Aggregate Search</h1>

	<form method="get" class="search-form">
		<div class="form-group">
			<label for="aggregateType">Aggregate Type</label>
			<input type="text" id="aggregateType" name="aggregateType" value="@Model.AggregateType" placeholder="e.g., OrderAggregate" class="form-control" />
		</div>

		<div class="form-group">
			<label for="aggregateId">Aggregate ID</label>
			<input type="text" id="aggregateId" name="aggregateId" value="@Model.AggregateId" placeholder="UUID or ID" class="form-control" />
		</div>

		<div class="form-group">
			<label for="page">Page</label>
			<input type="number" id="page" name="page" value="@Model.Page" min="1" class="form-control" />
		</div>

		<div class="form-group">
			<label for="pageSize">Page Size</label>
			<input type="number" id="pageSize" name="pageSize" value="@Model.PageSize" min="1" max="100" class="form-control" />
		</div>

		<button type="submit" class="btn btn-primary">Search</button>
	</form>

	@if (!ModelState.IsValid)
	{
		<div class="alert alert-danger">
			@foreach (var modelState in ModelState.Values)
			{
				@foreach (var error in modelState.Errors)
				{
					<p>@error.ErrorMessage</p>
				}
			}
		</div>
	}

	@if (Model.SearchResults != null)
	{
		<div class="search-results">
			<p>Total: @Model.SearchResults.TotalCount | Page @Model.SearchResults.Page of @Math.Ceiling((double)Model.SearchResults.TotalCount / Model.SearchResults.PageSize)</p>

			@if (Model.SearchResults.Items.Count > 0)
			{
				<table class="table table-striped">
					<thead>
						<tr>
							<th>Aggregate Type</th>
							<th>Aggregate ID</th>
							<th>Version</th>
							<th>Last Updated</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model.SearchResults.Items)
						{
							<tr>
								<td>@item.AggregateType</td>
								<td><code>@item.AggregateId</code></td>
								<td>@item.CurrentVersion</td>
								<td>@item.LastUpdatedUtc.ToString("u")</td>
								<td>
									<a href="/admin/events?aggregateType=@Uri.EscapeDataString(item.AggregateType)&aggregateId=@Uri.EscapeDataString(item.AggregateId)" class="btn btn-sm btn-info">Events</a>
									<a href="/admin/projection?aggregateType=@Uri.EscapeDataString(item.AggregateType)&aggregateId=@Uri.EscapeDataString(item.AggregateId)" class="btn btn-sm btn-success">Projection</a>
								</td>
							</tr>
						}
					</tbody>
				</table>

				@if (Model.Page > 1)
				{
					<a href="?aggregateType=@Uri.EscapeDataString(Model.AggregateType ?? "")&aggregateId=@Uri.EscapeDataString(Model.AggregateId ?? "")&page=@(Model.Page - 1)&pageSize=@Model.PageSize" class="btn btn-sm">Previous</a>
				}

				@if (Model.SearchResults.Page * Model.SearchResults.PageSize < Model.SearchResults.TotalCount)
				{
					<a href="?aggregateType=@Uri.EscapeDataString(Model.AggregateType ?? "")&aggregateId=@Uri.EscapeDataString(Model.AggregateId ?? "")&page=@(Model.Page + 1)&pageSize=@Model.PageSize" class="btn btn-sm">Next</a>
				}
			}
			else
			{
				<p>No aggregates found.</p>
			}
		</div>
	}
</div>
	.admin-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 20px;
	}

	.search-form {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 15px;
		margin-bottom: 20px;
		padding: 15px;
		background-color: #f5f5f5;
		border-radius: 4px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
	}

	.form-group label {
		font-weight: bold;
		margin-bottom: 5px;
		font-size: 14px;
	}

	.form-control {
		padding: 8px;
		border: 1px solid #ddd;
		border-radius: 3px;
		font-size: 14px;
	}

	.btn {
		padding: 8px 12px;
		border: none;
		border-radius: 3px;
		cursor: pointer;
		font-size: 14px;
		text-decoration: none;
		display: inline-block;
	}

	.btn-primary {
		background-color: #007bff;
		color: white;
	}

	.btn-primary:hover {
		background-color: #0056b3;
	}

	.btn-sm {
		padding: 4px 8px;
		font-size: 12px;
	}

	.btn-info {
		background-color: #17a2b8;
		color: white;
		text-decoration: none;
	}

	.btn-success {
		background-color: #28a745;
		color: white;
		text-decoration: none;
	}

	.table {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 20px;
	}

	.table thead {
		background-color: #f8f9fa;
	}

	.table th,
	.table td {
		padding: 12px;
		text-align: left;
		border-bottom: 1px solid #ddd;
	}

	.table tbody tr:hover {
		background-color: #f5f5f5;
	}

	.table-striped tbody tr:nth-child(odd) {
		background-color: #fafafa;
	}

	.search-results {
		background-color: #fff;
		padding: 15px;
		border: 1px solid #ddd;
		border-radius: 4px;
	}

	.alert {
		padding: 12px;
		margin-bottom: 20px;
		border-radius: 4px;
	}

	.alert-danger {
		background-color: #f8d7da;
		color: #721c24;
		border: 1px solid #f5c6cb;
	}

	code {
		background-color: #f4f4f4;
		padding: 2px 6px;
		border-radius: 3px;
		font-family: monospace;
		font-size: 12px;
	}
</style>
