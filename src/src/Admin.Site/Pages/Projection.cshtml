@page "/admin/projection"
@model Purview.EventSourcing.Admin.Site.Pages.ProjectionModel

@{
	ViewData["Title"] = "Projection";
}

<div class="admin-container">
	<h1>Point-in-Time Projection</h1>
	<p>
		<strong>Aggregate:</strong>
		<span class="badge">@Model.AggregateType</span>
		<code>@Model.AggregateId</code>
	</p>

	<form method="get" class="projection-form">
		<input type="hidden" name="aggregateType" value="@Model.AggregateType" />
		<input type="hidden" name="aggregateId" value="@Model.AggregateId" />

		<div class="form-group">
			<label>Project At:</label>
			<div class="projection-options">
				<div class="radio-group">
					<label>
						<input type="radio" name="projectionMode" value="version" @(Model.Version.HasValue ? "checked" : "") />
						Specific Version
					</label>
					<input type="number" id="version" name="version" value="@Model.Version" placeholder="Version number" class="form-control" />
				</div>

				<div class="radio-group">
					<label>
						<input type="radio" name="projectionMode" value="time" @(Model.AsOfUtc.HasValue ? "checked" : "") />
						Specific Time (UTC)
					</label>
					<input type="datetime-local" id="asOfUtc" name="asOfUtc" value="@Model.AsOfUtc?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
				</div>

				<div class="radio-group">
					<label>
						<input type="radio" name="projectionMode" value="latest" @(!Model.Version.HasValue && !Model.AsOfUtc.HasValue ? "checked" : "") />
						Latest
					</label>
				</div>
			</div>
		</div>

		<button type="submit" class="btn btn-primary">Project</button>
		<a href="/admin/events?aggregateType=@Uri.EscapeDataString(Model.AggregateType)&aggregateId=@Uri.EscapeDataString(Model.AggregateId)" class="btn btn-secondary">View Events</a>
		<a href="/" class="btn btn-secondary">Back to Aggregates</a>
	</form>

	@if (!ModelState.IsValid)
	{
		<div class="alert alert-danger">
			@foreach (var modelState in ModelState.Values)
			{
				@foreach (var error in modelState.Errors)
				{
					<p>@error.ErrorMessage</p>
				}
			}
		</div>
	}

	@if (Model.Projection != null)
	{
		<div class="projection-result">
			<div class="projection-info">
				<h2>Projection Result</h2>
				<p>
					<strong>Aggregate Version:</strong> @Model.Projection.ProjectedVersion
				</p>
				<p>
					<strong>Projected At:</strong> @Model.Projection.ProjectedAtUtc?.ToString("u")
				</p>
			</div>

			<div class="provenance-info">
				<h3>Provenance</h3>
				<div class="provenance-stats">
					<div class="stat">
						<span class="stat-label">Events Applied:</span>
						<span class="stat-value">@Model.Projection.Provenance.AppliedCount</span>
					</div>
					<div class="stat">
						<span class="stat-label">Events Skipped:</span>
						<span class="stat-value">@Model.Projection.Provenance.SkippedCount</span>
					</div>
				</div>

				@if (!string.IsNullOrEmpty(Model.Projection.Provenance.Reason))
				{
					<p><strong>Reason:</strong> @Model.Projection.Provenance.Reason</p>
				}

				@if (Model.Projection.Provenance.AppliedVersions.Count > 0)
				{
					<details class="provenance-details">
						<summary>Applied Versions (@Model.Projection.Provenance.AppliedVersions.Count)</summary>
						<div class="version-list">
							@foreach (var version in Model.Projection.Provenance.AppliedVersions)
							{
								<span class="version-badge">@version</span>
							}
						</div>
					</details>
				}

				@if (Model.Projection.Provenance.SkippedVersions.Count > 0)
				{
					<details class="provenance-details">
						<summary>Skipped Versions (@Model.Projection.Provenance.SkippedVersions.Count)</summary>
						<div class="version-list">
							@foreach (var version in Model.Projection.Provenance.SkippedVersions)
							{
								<span class="version-badge skipped">@version</span>
							}
						</div>
					</details>
				}
			</div>

			<details class="state-details">
				<summary>Aggregate State</summary>
				<pre><code>@Model.Projection.State.ToString()</code></pre>
			</details>
		</div>
	}
</div>

<style>
	.admin-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 20px;
	}

	.badge {
		display: inline-block;
		padding: 4px 8px;
		background-color: #007bff;
		color: white;
		border-radius: 3px;
		font-size: 12px;
		margin-right: 10px;
	}

	.projection-form {
		background-color: #f5f5f5;
		padding: 20px;
		border-radius: 4px;
		margin-bottom: 20px;
	}

	.form-group {
		margin-bottom: 20px;
	}

	.form-group label {
		font-weight: bold;
		display: block;
		margin-bottom: 10px;
	}

	.projection-options {
		display: flex;
		flex-direction: column;
		gap: 15px;
	}

	.radio-group {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px;
		background-color: white;
		border-radius: 3px;
		border: 1px solid #ddd;
	}

	.radio-group label {
		margin-bottom: 0;
		font-weight: normal;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.form-control {
		padding: 8px;
		border: 1px solid #ddd;
		border-radius: 3px;
		font-size: 14px;
	}

	.btn {
		padding: 8px 12px;
		border: none;
		border-radius: 3px;
		cursor: pointer;
		font-size: 14px;
		text-decoration: none;
		display: inline-block;
		margin-right: 5px;
	}

	.btn-primary {
		background-color: #007bff;
		color: white;
	}

	.btn-secondary {
		background-color: #6c757d;
		color: white;
	}

	.projection-result {
		background-color: #fff;
		padding: 20px;
		border: 1px solid #ddd;
		border-radius: 4px;
	}

	.projection-info {
		margin-bottom: 20px;
		padding-bottom: 20px;
		border-bottom: 2px solid #eee;
	}

	.projection-info h2 {
		margin-top: 0;
	}

	.projection-info p {
		margin: 8px 0;
	}

	.provenance-info {
		background-color: #f9f9f9;
		padding: 15px;
		border-radius: 4px;
		margin-bottom: 20px;
	}

	.provenance-info h3 {
		margin-top: 0;
	}

	.provenance-stats {
		display: flex;
		gap: 20px;
		margin-bottom: 15px;
	}

	.stat {
		display: flex;
		flex-direction: column;
	}

	.stat-label {
		font-weight: bold;
		color: #666;
		font-size: 12px;
	}

	.stat-value {
		font-size: 24px;
		font-weight: bold;
		color: #007bff;
	}

	.provenance-details {
		cursor: pointer;
		margin-top: 10px;
	}

	.provenance-details summary {
		font-weight: bold;
		padding: 8px;
		background-color: #e9ecef;
		border-radius: 3px;
		user-select: none;
	}

	.version-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 10px;
		padding: 10px;
		background-color: white;
		border-radius: 3px;
	}

	.version-badge {
		display: inline-block;
		padding: 4px 8px;
		background-color: #d4edda;
		color: #155724;
		border-radius: 3px;
		font-family: monospace;
		font-size: 12px;
	}

	.version-badge.skipped {
		background-color: #f8d7da;
		color: #721c24;
	}

	.state-details {
		cursor: pointer;
		margin-top: 20px;
	}

	.state-details summary {
		font-weight: bold;
		padding: 8px;
		background-color: #e9ecef;
		border-radius: 3px;
		user-select: none;
	}

	.state-details pre {
		background-color: #f4f4f4;
		border: 1px solid #ddd;
		border-radius: 3px;
		padding: 15px;
		margin-top: 10px;
		overflow-x: auto;
		font-size: 12px;
	}

	.state-details code {
		font-family: monospace;
	}

	.alert {
		padding: 12px;
		margin-bottom: 20px;
		border-radius: 4px;
	}

	.alert-danger {
		background-color: #f8d7da;
		color: #721c24;
		border: 1px solid #f5c6cb;
	}

	code {
		background-color: #f4f4f4;
		padding: 2px 6px;
		border-radius: 3px;
		font-family: monospace;
		font-size: 12px;
	}
</style>
