<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Store for PostgreSQL</Title>
		<Description>PostgreSQL event stream and queryable snapshot storage provider for Purview EventSourcing.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;event-store;postgres;postgresql;events;</PackageTags>
		<PackageId>Purview.EventSourcing.Postgres</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Aspire.Npgsql" />
		<PackageReference Include="LinqKit" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.Options" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EventSourcing\EventSourcing.csproj" />
		<ProjectReference
			Include="..\ImplementationShared\ImplementationShared.csproj"
			PrivateAssets="All"
		/>
	</ItemGroup>
</Project>
