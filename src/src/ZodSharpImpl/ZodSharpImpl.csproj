<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Sourcing ZodSharp Integration</Title>
		<Description>ZodSharp adapter for Purview EventSourcing — bridges FluentValidation IValidator&lt;T&gt; with IAggregateValidator&lt;T&gt;.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;validation;zod;zodsharp;</PackageTags>
		<RootNamespace>Purview.EventSourcing.ZodSharp</RootNamespace>
		<!-- The buildTransitive guard target (Sdk/buildTransitive/Purview.EventSourcing.ZodSharp.targets) matches
		     consumers by this exact package id, and the published package name is documented as
		     Purview.EventSourcing.ZodSharp. The SDK-derived id (Purview.EventSourcing.ZodSharpImpl) would orphan
		     the guard and produce NU5129, so the id is pinned explicitly. -->
		<PackageId>Purview.EventSourcing.ZodSharp</PackageId>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="ZodSharp" PrivateAssets="contentfiles;build" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\EventSourcing\EventSourcing.csproj" />
	</ItemGroup>
</Project>
