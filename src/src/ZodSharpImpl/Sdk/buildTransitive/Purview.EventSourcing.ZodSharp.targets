<Project>
	<Target Name="ValidateZodSharpDirectReference" BeforeTargets="ResolveReferences">
		<ItemGroup>
			<_PurviewEventSourcingZodSharpPackage
				Include="@(PackageReference)"
				Condition="'%(PackageReference.Identity)' == 'Purview.EventSourcing.ZodSharp'"
			/>
			<_ZodSharpDirectPackage
				Include="@(PackageReference)"
				Condition="'%(PackageReference.Identity)' == 'ZodSharp'"
			/>
		</ItemGroup>

		<Error
			Condition="'@(_PurviewEventSourcingZodSharpPackage)' != '' and '@(_ZodSharpDirectPackage)' == ''"
			Text="Project '$(MSBuildProjectName)' references 'Purview.EventSourcing.ZodSharp' but does not include a direct PackageReference to 'ZodSharp'. Add '&lt;PackageReference Include=&quot;ZodSharp&quot; /&gt;' to avoid runtime assembly load failures."
		/>
	</Target>
</Project>
