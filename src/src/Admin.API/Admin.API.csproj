<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup Label="NuGet Package Values">
		<IsPackable>true</IsPackable>
		<Title>Purview Event Sourcing Admin Portal API</Title>
		<Description>ASP.NET Minimal API endpoints for Purview EventSourcing Admin Portal with OpenAPI documentation.</Description>
		<PackageTags>$(PackageTags);purview;dotnet;event-sourcing;admin;api;openapi;</PackageTags>
		<PackageId>Purview.EventSourcing.Admin.Api</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Admin.Abstractions\Admin.Abstractions.csproj" />
		<ProjectReference Include="..\Admin.Security\Admin.Security.csproj" />
		<ProjectReference Include="..\EventSourcing\EventSourcing.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>
</Project>
