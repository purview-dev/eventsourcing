<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<!--
			The shared provider-agnostic contract suites (Contracts/**) are compiled into this library
			and consumed by the provider integration test projects through the existing assembly
			reference. Their [Test] methods are picked up by the test projects' [InheritsTests] derived
			classes. This library's own tests are skipped by the SDK's shared-testing [Skip] attribute.
		-->
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="TUnit.Assertions" />
		<PackageReference Include="Testcontainers.Azurite" />
		<PackageReference Include="Testcontainers.CosmosDb" />
		<PackageReference Include="Testcontainers.MongoDb" />
		<PackageReference Include="Testcontainers.MsSql" />
		<PackageReference Include="Testcontainers.PostgreSql" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\AzureStorage\AzureStorage.csproj" />
		<ProjectReference Include="..\..\src\CosmosDb\CosmosDb.csproj" />
		<ProjectReference Include="..\..\src\ImplementationShared\ImplementationShared.csproj" />
		<ProjectReference Include="..\..\src\MongoDB\MongoDB.csproj" />
		<ProjectReference Include="..\..\src\Postgres\Postgres.csproj" />
		<ProjectReference Include="..\..\src\SqlServer\SqlServer.csproj" />
		<!-- Direct reference required when not used via a NuGet package -->
		<ProjectReference
			Include="..\..\src\SourceGenerator\SourceGenerator.csproj"
			OutputItemType="Analyzer"
			ReferenceOutputAssembly="false"
			PrivateAssets="all"
		/>
	</ItemGroup>
</Project>
