<Project>
	<PropertyGroup>
		<NamespacePrefix>Purview.EventSourcing</NamespacePrefix>
		<IsPackable>false</IsPackable>
		<UsePackageJsonVersion>Strict</UsePackageJsonVersion>
	</PropertyGroup>

	<Import Sdk="Purview.DotNetProjectSdk" Project="Sdk.props" />

	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>
			$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage
		</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);CS0436;</NoWarn>
		<!-- CS1574 (unresolvable cref) is suppressed because cross-assembly crefs cannot always be resolved;
		     CS1591 (missing XML docs) is deliberately reported so documentation is enforced on packable projects. -->
		<NoWarn>$(NoWarn);CS1574;</NoWarn>
		<AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsTestProject)' == 'true' OR '$(IsSharedTestingProject)' == 'true'">
		<NoWarn>$(NoWarn);CA1031;CA2234</NoWarn>
	</PropertyGroup>

	<ItemGroup Label="TUnit integration test retries" Condition="'$(TestingType)' == 'Integration'">
		<AssemblyAttribute Include="TUnit.Core.Retry">
			<_Parameter1>3</_Parameter1>
			<_Parameter1_TypeName>System.Int32</_Parameter1_TypeName>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup Label="NuGet package metadata">
		<Authors>Kieron Lanning</Authors>
		<Company>Purview-Dev</Company>
		<Copyright>Copyright © $(CurrentYear) Purview-Dev</Copyright>
		<RepositoryUrl>https://github.com/purview-dev/purview-eventsourcing.git</RepositoryUrl>
		<PackageProjectUrl>https://github.com/purview-dev/purview-eventsourcing</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>purview-logo.jpg</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>
		<DebugType>portable</DebugType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup Label="NuGet package assets" Condition="'$(IsPackable)' == 'true'">
		<!-- Prefer the project-local README when present, otherwise fall back to the repository README. -->
		<None
			Include="$(MSBuildProjectDirectory)/README.md"
			Pack="true"
			PackagePath="/"
			Condition="Exists('$(MSBuildProjectDirectory)/README.md')"
		/>
		<None
			Include="$(MSBuildThisFileDirectory)../README.md"
			Pack="true"
			PackagePath="/"
			Condition="!Exists('$(MSBuildProjectDirectory)/README.md')"
		/>
		<None Include="$(MSBuildThisFileDirectory)../LICENSE.md" Pack="true" PackagePath="/" />
		<None Include="$(MSBuildThisFileDirectory)../assets/images/purview-logo.jpg" Pack="true" PackagePath="/" />
	</ItemGroup>

	<PropertyGroup Condition="'$(IsTestProject)' != 'true' AND '$(IsSharedTestingProject)' != 'true'">
		<WarningsAsErrors>$(WarningsAsErrors);CA1031;CA1822</WarningsAsErrors>
	</PropertyGroup>
</Project>
